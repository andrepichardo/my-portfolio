{
  "extends": [
    "development"
  ],
  "hints": {
    "axe/name-role-value": [
      "default",
      {
        "link-name": "off"
      }
    ],
    "disown-opener": "off",
    "no-inline-styles": "off",
    "axe/aria": "off",
    "compat-api/css": "off"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not and_chr <= 123",
    "not chrome <= 124",
    "not edge <= 123",
    "not opera <= 109",
    "not samsung <= 24"
  ]
}